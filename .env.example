# ── SERVER ─────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3001

# Optional: public origin (no trailing slash). Sent as webhook_url on POST /bot so Skribby can POST status updates.
# There is typically no "Add webhook" in the Skribby UI — URL is per-bot via API. If unset, the app still polls GET /bot.
# Example: SKRIBBY_WEBHOOK_BASE=https://abc123.ngrok-free.app
# See WEBHOOKS.md (repo root) and docs/TASK_FLOW_AND_RND.md (flow + R&D checklist).
SKRIBBY_WEBHOOK_BASE=

# Poll GET /bot for recent sessions when push webhooks are unavailable (default: on).
SKRIBBY_POLL_ENABLED=true
SKRIBBY_POLL_INTERVAL_MS=60000

# ── DATABASE ───────────────────────────────────────────
DB_HOST=localhost
DB_USER_NAME=postgres
DB_PASSWORD=
DB_DATABASE=skribbydemo
DB_PORT=5432
DB_DIALECT=postgres
DATABASE_SSL=true

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=change_this_to_any_long_random_string_32chars

# ── OPENAI (optional fallbacks if you do not set the specific keys below) ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1

# ── POST-MEETING: record with Skribby → download audio → YOUR transcription ──
# recording_openai_whisper (default) = ignore Skribby transcript; use recording_url + your Whisper-compatible API
# recording_custom_http = POST multipart file to TRANSCRIPTION_HTTP_URL
# skribby_native_then_whisper = use Skribby transcript first; if short, fall back to audio + POST_MEETING_FALLBACK_TRANSCRIPTION
POST_MEETING_TRANSCRIPT_SOURCE=recording_openai_whisper
POST_MEETING_FALLBACK_TRANSCRIPTION=recording_openai_whisper
RECORDING_URL_MAX_ATTEMPTS=12
RECORDING_URL_RETRY_MS=5000
TRANSCRIPTION_MAX_FILE_MB=24
# Keep archived copy for Summaries ▶ playback (default true). Files: downloads/skribby-audio/skribby_bot_<botId>.<ext>
# TRANSCRIPTION_KEEP_AUDIO_COPY=true
# TRANSCRIPTION_AUDIO_DOWNLOAD_DIR=downloads/skribby-audio
# When several skribby_audio_<timestamp>.* files exist, pick the one whose mtime is closest to session end (hours).
# TRANSCRIPTION_ARCHIVE_MATCH_WINDOW_HOURS=6

# Keys for speech-to-text (defaults to OPENAI_API_KEY / OPENAI_API_BASE)
TRANSCRIPTION_OPENAI_API_KEY=
TRANSCRIPTION_OPENAI_BASE_URL=
TRANSCRIPTION_WHISPER_MODEL=whisper-1
# ISO-639-1 (e.g. hi for Hindi, en for English). Empty = auto-detect (recommended if meetings mix languages).
# TRANSCRIPTION_LANGUAGE=hi
# Drop Whisper segments likely to be silence hallucinations (0–1, stricter = lower value)
# TRANSCRIPTION_SEGMENT_MAX_NO_SPEECH_PROB=0.45
# TRANSCRIPTION_SEGMENT_MAX_COMPRESSION_RATIO=2.4

# Custom STT HTTP (when POST_MEETING_TRANSCRIPT_SOURCE=recording_custom_http)
TRANSCRIPTION_HTTP_URL=
TRANSCRIPTION_HTTP_API_KEY=
TRANSCRIPTION_HTTP_AUTH_HEADER=Authorization
TRANSCRIPTION_HTTP_AUTH_PREFIX=Bearer 
TRANSCRIPTION_HTTP_FILE_FIELD=file

# GPT summary after transcript (runs on your server with SUMMARY_* / OPENAI keys — not sent to Skribby)
SUMMARY_AFTER_TRANSCRIPTION=true
SUMMARY_OPENAI_API_KEY=
SUMMARY_OPENAI_BASE_URL=
# gpt-4o-mini recommended for reliable JSON summaries; override with gpt-4 if needed
SUMMARY_MODEL=gpt-4o-mini
# SUMMARY_JSON_MODE=false if your chat model does not support response_format json_object
# SUMMARY_MAX_TRANSCRIPT_CHARS=120000

# ── SKRIBBY ────────────────────────────────────────────
SKRIBBY_API_KEY=your_skribby_api_key
# Optional override (default: https://platform.skribby.io/api/v1)
# SKRIBBY_API_BASE=https://platform.skribby.io/api/v1
# Required by Skribby Create Bot; use a cheap model on your plan if you only transcribe locally via recording_openai_whisper
SKRIBBY_TRANSCRIPTION_MODEL=openai/whisper-large-v3
SKRIBBY_LANG=en
# SKRIBBY_RECORD_VIDEO=true
# From Skribby dashboard → Webhooks → Settings (signing secret only; not where you paste the endpoint URL)
SKRIBBY_WEBHOOK_SECRET=

# ── ZOOM (scheduled meetings list) ─────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_REDIRECT_URI=https://YOUR_NGROK_URL.ngrok-free.app/api/zoom/callback

# ── GOOGLE CALENDAR (Meet links via Calendar API) ──────
# docs/SCHEDULED_MEETINGS_INTEGRATION.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_NGROK_URL.ngrok-free.app/api/google/callback

# ── MICROSOFT GRAPH (Teams via calendar) ───────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://YOUR_NGROK_URL.ngrok-free.app/api/microsoft/callback
# Optional: tenant id; default "common" for multi-tenant + many personal accounts
# MICROSOFT_TENANT_ID=common

# ── AUTO BOT FROM CALENDAR (Zoom / Google / Microsoft APIs only) ──
# When the UI loads scheduled meetings with auto_schedule=1, the server saves upcoming
# events with join links and calls Skribby (scheduled_start_time for future starts).
# Skribby joins at meeting time — no OS cron on your server.
AUTO_SCHEDULE_BOTS=true
# If the meeting starts within this many seconds, deploy the bot immediately (no Skribby schedule).
AUTO_SCHEDULE_IMMINENT_SEC=180
# Skip auto-join if the meeting start is more than this many minutes in the past.
AUTO_SCHEDULE_GRACE_PAST_MIN=10

# ── BOT CONFIG ─────────────────────────────────────────
BOT_NAME=AI Notetaker
